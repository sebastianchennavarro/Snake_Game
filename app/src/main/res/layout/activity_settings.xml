<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙ CONFIGURACIÓN"
            android:textSize="28sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:gravity="center"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginBottom="24dp" />

        <!-- ================= AUDIO ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔊 AUDIO"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Música"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarMusic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="70"
                android:progressTint="#00FF00"
                android:thumbTint="#00FF00" />

            <TextView
                android:id="@+id/tvMusicVolume"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="70%"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:gravity="end"
                android:fontFamily="@font/vcr_osd_mono_1_001" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Efectos de sonido"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarSFX"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="85"
                android:progressTint="#00FF00"
                android:thumbTint="#00FF00" />

            <TextView
                android:id="@+id/tvSFXVolume"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:gravity="end"
                android:fontFamily="@font/vcr_osd_mono_1_001" />
        </LinearLayout>

        <!-- ================= JUEGO ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎮 JUEGO"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dificultad"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <RadioGroup
            android:id="@+id/rgDifficulty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbEasy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fácil"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#00FF00"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <RadioButton
                android:id="@+id/rbNormal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Normal"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#00FF00"
                android:checked="true"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <RadioButton
                android:id="@+id/rbHard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Difícil"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#00FF00"
                android:fontFamily="@font/vcr_osd_mono_1_001" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Velocidad inicial"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarSpeed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="10"
                android:progress="5"
                android:progressTint="#00FF00"
                android:thumbTint="#00FF00" />

            <TextView
                android:id="@+id/tvSpeedValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:gravity="end"
                android:fontFamily="@font/vcr_osd_mono_1_001" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vibración"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchVibration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#00FF00"
                android:trackTint="#AAAAAA" />
        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👁 VISUAL"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tema visual"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <Spinner
            android:id="@+id/spinnerTheme"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/button_retro_style"
            android:popupBackground="#121212" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mostrar FPS"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchFPS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumbTint="#00FF00"
                android:trackTint="#AAAAAA" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Efectos de partículas"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchParticles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#00FF00"
                android:trackTint="#AAAAAA" />
        </LinearLayout>

        <!-- 🔆 NUEVO: MODO NOCHE / DÍA -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modo noche"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNightMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumbTint="#00FF00"
                android:trackTint="#AAAAAA" />
        </LinearLayout>
        <!-- ================= CONTROLES ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕹 CONTROLES"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de control"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <RadioGroup
            android:id="@+id/rgControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbSwipe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deslizar (Swipe)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#00FF00"
                android:checked="true"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <RadioButton
                android:id="@+id/rbButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Botones en pantalla"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#00FF00"
                android:fontFamily="@font/vcr_osd_mono_1_001" />

            <RadioButton
                android:id="@+id/rbTilt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Inclinación (Giroscopio)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:buttonTint="#00FF00"
                android:fontFamily="@font/vcr_osd_mono_1_001" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensibilidad de controles"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/seekBarSensitivity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50"
                android:progressTint="#00FF00"
                android:thumbTint="#00FF00" />

            <TextView
                android:id="@+id/tvSensitivityValue"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:text="50%"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:gravity="end"
                android:fontFamily="@font/vcr_osd_mono_1_001" />
        </LinearLayout>

        <!-- ================= CUENTA ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 CUENTA"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnChangeUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cambiar usuario"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClearData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Borrar todos los datos"
            android:textColor="#FF0000"
            android:background="@drawable/button_retro_style"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <!-- ================= INFORMACIÓN ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ℹ INFORMACIÓN"
            android:textSize="20sp"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:background="#1E1E1E"
            android:padding="8dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Acerca de"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnResetDefaults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restaurar valores predeterminados"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Volver al Menú"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>