<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- GameView principal -->
    <com.example.test_snake.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toStartOf="@+id/controllerPanel" />

    <!-- Panel de controles responsive -->
    <LinearLayout
        android:id="@+id/controllerPanel"
        android:layout_width="162dp"
        android:layout_height="288dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="15dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/gameboy_panel_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Puntuación -->
        <TextView
            android:id="@+id/scoreText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#80000000"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:padding="3dp"
            android:text="SCORE: 0"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Imagen de la serpiente -->
        <ImageView
            android:layout_width="55dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Snake character"
            android:scaleType="fitCenter"
            android:src="@mipmap/imgsnake" />

        <!-- Controles direccionales -->
        <Button
            android:id="@+id/btnUp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="@drawable/gameboy_button"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:text="↑"
            android:textColor="#00FF00"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Flechas izquierda y derecha -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnLeft"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_margin="2dp"
                android:background="@drawable/gameboy_button"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:text="←"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRight"
                android:layout_width="40dp"
                android:layout_height="50dp"
                android:layout_margin="2dp"
                android:background="@drawable/gameboy_button"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:text="→"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Flecha abajo -->
        <Button
            android:id="@+id/btnDown"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="2dp"
            android:background="@drawable/gameboy_button"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:text="↓"
            android:textColor="#00FF00"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/coinsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#80000000"
            android:fontFamily="@font/vcr_osd_mono_1_001"
            android:padding="2dp"
            android:text="MONEDAS: 0"
            android:textColor="#FFD700"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Monedas -->
    </LinearLayout>

</RelativeLayout>