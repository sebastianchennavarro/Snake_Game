<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="#1A1A1A">

    <ImageView
        android:id="@+id/skinImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/skin_default" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp">

        <TextView
            android:id="@+id/skinName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre de skin"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <TextView
            android:id="@+id/skinPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Precio: 0"
            android:textColor="#FFD700"
            android:textSize="14sp"
            android:fontFamily="@font/vcr_osd_mono_1_001" />
    </LinearLayout>

    <Button
        android:id="@+id/skinButton"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Comprar"
        android:background="@drawable/button_retro_style"
        android:textColor="#00FF00"
        android:fontFamily="@font/vcr_osd_mono_1_001" />
</LinearLayout>
