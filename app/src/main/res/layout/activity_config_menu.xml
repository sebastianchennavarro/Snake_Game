<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONFIGURACIÓN"
        android:textColor="#00FF00"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:layout_marginBottom="60dp" />

    <!-- Fila Música -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp"
        android:paddingHorizontal="20dp">

        <Button
            android:id="@+id/btn_musica"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="MÚSICA"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <Switch
            android:id="@+id/sw_musica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:layout_marginStart="20dp"
            android:thumbTint="#00FF00"
            android:trackTint="#333333" />

    </LinearLayout>

    <!-- Fila Volumen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="30dp"
        android:paddingHorizontal="20dp">

        <Button
            android:id="@+id/btn_volumen"
            android:layout_width="200dp"
            android:layout_height="60dp"
            android:text="VOLUMEN"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:textStyle="bold"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <SeekBar
            android:id="@+id/sbar_Volumen"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:progress="50"
            android:max="100"
            android:layout_marginStart="20dp"
            android:progressTint="#00FF00"
            android:thumbTint="#00FF00" />

    </LinearLayout>

    <!-- Botón Créditos -->
    <Button
        android:id="@+id/btn_creditos"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="CRÉDITOS"
        android:textColor="#00FF00"
        android:background="@drawable/button_retro_style"
        android:textStyle="bold"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:layout_marginBottom="20dp" />

    <!-- Botón Reanudar -->
    <Button
        android:id="@+id/btn_reanudar"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="REANUDAR"
        android:textColor="#00FF00"
        android:background="@drawable/button_retro_style"
        android:textStyle="bold"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:layout_marginBottom="20dp" />

    <!-- Botón Salir -->
    <Button
        android:id="@+id/btn_salir"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="SALIR"
        android:textColor="#FF4444"
        android:background="@drawable/button_retro_style"
        android:textStyle="bold"
        android:fontFamily="@font/vcr_osd_mono_1_001" />

</LinearLayout>