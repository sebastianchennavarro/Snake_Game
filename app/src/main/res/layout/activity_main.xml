<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Usuario y acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tvUsername"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hola, Invitado"
            android:textColor="#00FF00"
            android:textSize="16sp"
            android:fontFamily="@font/vcr_osd_mono_1_001" />

        <Button
            android:id="@+id/btnEditUser"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:text="Editar"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Salir Sesión"
            android:textColor="#00FF00"
            android:background="@drawable/button_retro_style"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Título del juego -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="40dp"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:letterSpacing="0.1"
        android:text="SNAKE GAME"
        android:textColor="#00FF00"
        android:textSize="42sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="240dp"
        android:layout_height="140dp"
        app:srcCompat="@mipmap/imgsnake"
        android:layout_marginBottom="20dp" />

    <!-- Contenedor principal de botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="50dp">

        <!-- Columna izquierda -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnStartGame"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:text="JUGAR"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnScores"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:text="PUNTUACIONES"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Columna derecha -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:text="CONFIGURACIÓN"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnTienda"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_margin="8dp"
                android:background="@drawable/button_retro_style"
                android:fontFamily="@font/vcr_osd_mono_1_001"
                android:text="TIENDA"
                android:textColor="#00FF00"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

    <!-- Botón Salir -->
    <Button
        android:id="@+id/btnExit"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="60dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="40dp"
        android:background="@drawable/button_retro_style"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:letterSpacing="0.05"
        android:text="SALIR"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Texto inferior -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/vcr_osd_mono_1_001"
        android:letterSpacing="0.1"
        android:text="©2025 SNAKE ULATINA"
        android:textColor="#666666"
        android:textSize="12sp" />

</LinearLayout>
